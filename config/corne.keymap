#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    combos {
        compatible = "zmk,combos";

        copy_combo {
            bindings = <&kp LC(C)>;
            key-positions = <15 16>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <0>;
        };

        paste_combo {
            bindings = <&kp LC(V)>;
            key-positions = <16 27>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <0>;
        };

        cut_combo {
            bindings = <&kp LC(X)>;
            key-positions = <16 3>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <0>;
        };

        select_all_combo {
            bindings = <&kp LC(A)>;
            key-positions = <16 14>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <0>;
        };

        enter_combo {
            bindings = <&kp ENTER>;
            key-positions = <27 28>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <0>;
        };

        undo_combo {
            bindings = <&kp LC(Z)>;
            key-positions = <27 26>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <0>;
        };

        redo_combo {
            bindings = <&kp LC(LS(Z))>;
            key-positions = <26 28>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <0>;
        };

        save_combo {
            bindings = <&kp LC(S)>;
            key-positions = <15 14>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <0>;
        };

        tab_combo {
            bindings = <&kp TAB>;
            key-positions = <13 16>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB    &kp P  &kp C  &kp L         &kp M  &kp V        &kp X                &kp U            &kp O          &kp Y  &kp F  &kp ESC
&kp LSHFT  &kp N  &kp S  &kp R         &kp T  &kp D        &kp DOT              &kp A            &kp E          &kp I  &kp G  &kp BSPC
&kp LCTRL  &kp B  &kp G  &kp APOS      &kp W  &kp Z        &kp FSLH             &kp COMMA        &kp Q          &kp J  &kp K  &kp DELETE
                         &kp LEFT_ALT  &mo 1  &kp SPACE    &mt RIGHT_SHIFT RET  &lt 2 BACKSPACE  &kp RIGHT_GUI
            >;
        };

        LEFT_LAYER {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &trans  &kp N1  &kp N2  &kp N3  &kp DELETE    &trans  &trans    &kp UP_ARROW  &trans     &trans  &trans
&trans  &mo 3   &kp N4  &kp N5  &kp N6  &kp BSPC      &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &trans  &trans
&trans  &kp N0  &kp N7  &kp N8  &kp N9  &kp DOT       &trans  &trans    &trans        &trans     &trans  &trans
                        &trans  &trans  &trans        &trans  &trans    &trans
            >;
        };

        RIGHT_LAYER {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5          &kp F8  &kp F9    &kp F10   &kp F11   &kp F12  &trans
&trans  &trans        &kp GRAVE     &kp EQUAL     &kp MINUS     &kp F6          &kp F7  &kp LBKT  &kp RBKT  &kp BSLH  &trans   &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &kp APOS  &trans    &trans    &trans   &trans
                                    &trans        &trans        &trans          &trans  &trans    &trans
            >;
        };

        L_ARROWS {
            bindings = <
&trans  &trans  &trans    &kp UP_ARROW  &trans     &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &trans        &trans     &trans    &trans  &trans  &trans  &trans  &trans  &trans
                          &trans        &trans     &trans    &trans  &trans  &trans
            >;
        };
    };
};
