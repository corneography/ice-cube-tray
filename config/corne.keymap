#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        copy_combo {
            bindings = <&kp LC(C)>;
            key-positions = <15 16>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <0>;
        };

        paste_combo {
            bindings = <&kp LC(V)>;
            key-positions = <16 27>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <0>;
        };

        cut_combo {
            bindings = <&kp LC(X)>;
            key-positions = <15 4>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <0>;
        };

        select_all_combo {
            bindings = <&kp LC(A)>;
            key-positions = <16 14>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <0>;
        };

        enter_combo {
            bindings = <&kp ENTER>;
            key-positions = <27 28>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <0>;
        };

        undo_combo {
            bindings = <&kp LC(Z)>;
            key-positions = <27 26>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <0>;
        };

        redo_combo {
            bindings = <&kp LC(LS(Z))>;
            key-positions = <26 28>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <0>;
        };

        save_combo {
            bindings = <&kp LC(S)>;
            key-positions = <15 14>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <0>;
        };

        alt_tab_combo {
            bindings = <&kp LA(TAB)>;
            key-positions = <13 16>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <0>;
        };

        ctrl_bksp {
            bindings = <&kp LC(BACKSPACE)>;
            key-positions = <19 20>;
            timeout-ms = <30>;
            require-prior-idle-ms = <30>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESCAPE  &kp Q  &kp W  &kp E                  &kp R        &kp T                     &kp Y      &kp U            &kp I          &kp O    &kp P     &mo 3
&kp TAB     &kp A  &kp S  &kp D                  &kp F        &kp G                     &kp H      &kp J            &kp K          &kp L    &kp SEMI  &kp BSPC
&kp LCTRL   &kp Z  &kp X  &kp C                  &kp V        &kp B                     &kp N      &kp M            &kp COMMA      &kp DOT  &kp FSLH  &kp DELETE
                          &mt LEFT_SHIFT ESCAPE  &lt 1 SPACE  &mt LEFT_ALT BACKSPACE    &kp ENTER  &lt 2 BACKSPACE  &kp RIGHT_GUI
            >;
        };

        LEFT_LAYER {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans        &kp LG(LS(S))   &kp N1  &kp N2  &kp N3  &kp DELETE      &trans  &trans    &kp UP_ARROW  &trans     &trans  &trans
&kp CAPSLOCK  &kp LEFT_SHIFT  &kp N4  &kp N5  &kp N6  &kp BSPC        &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &trans  &trans
&trans        &kp PERIOD      &kp N7  &kp N8  &kp N9  &kp NUMBER_0    &trans  &trans    &trans        &trans     &trans  &trans
                                      &trans  &trans  &trans          &trans  &trans    &trans
            >;
        };

        RIGHT_LAYER {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp F1  &kp F2     &kp F3     &kp F4     &kp F5    &kp F8  &kp F9    &kp F10   &kp F11   &kp F12  &trans
&trans  &trans  &kp GRAVE  &kp EQUAL  &kp MINUS  &kp F6    &kp F7  &kp LBKT  &kp RBKT  &kp BSLH  &trans   &trans
&trans  &trans  &trans     &trans     &trans     &trans    &trans  &kp APOS  &trans    &trans    &trans   &trans
                           &trans     &trans     &trans    &trans  &trans    &trans
            >;
        };

        CONF_LAYER {
            bindings = <
&trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans        &trans        &trans          &trans  &trans  &trans
            >;
        };
    };
};
